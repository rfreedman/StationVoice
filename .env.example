# Copy to .env and uncomment to enable. Real environment variables win over this file.

# --- Core / process ---
# HOST=0.0.0.0
# PORT=8000
# DATA_DIR=./data
# USERS_PATH=./data/users.json
# TTS_PCM_CACHE_DIR=./data/pcm
# LOG_DIR=./data/logs
# LOG_KEEP_DAYS=30
# TTS_VOICES_DIR=./voices
# TTS_PIPER_VOICES_FILE=./config/piper-voices.json
# TTS_DEFAULT_VOICE=en_US-ryan-medium
# TTS_PIPER_QUALITIES=all
# TIMEZONE=America/New_York
# MAX_TEXT_CHARS=5000
# AUDIO_ANNOUNCEMENT_MAX_BYTES=5242880
# TTS_SPEED=1.0
# TTS_SENTENCE_PAUSE=0.25
# PTT_LEAD_SECONDS=1
# BUSY_RETRY_SECONDS=5
# BUSY_GIVE_UP_SECONDS=45
# SLOT_HALF_WINDOW_MINUTES=10
# SLOT_LOOKAHEAD_HOURS=72
# SCHEDULER_MAX_WAIT_SECONDS=5
# NEWS_CHECK_START=12:00
# NEWS_CHECK_STOP=18:00
# NEWS_CHECK_INTERVAL_HOURS=1
# REPEATER_TIMEOUT_SECONDS=180
# NEWSLINE_RESTART_AFTER_PROCESS=false

# Cooler Newsline splits on a small Linux host (slower; default is faster/hotter):
# ARNEWSLINE_QA_WORKERS=1
# ARNEWSLINE_EXPORT_WORKERS=1
# ARNEWSLINE_CPU_THREADS=2

# Station identity (page heading, browser title, logo alt, macOS idle assertion). Required.
STATION_CALL=N0CALL
STATION_NAME=Example Radio Club
# APP_TITLE=N0CALL Announcements

# A DRA (Digital Radio Adapter) is the USB box between the computer and one radio.
# This project uses the Masters Communications DRA-36M
# (https://www.masterscommunications.com/products/radio-adapter/dra/dra36m.html).
# It plays the announcement into the radio and keys the transmitter.
# RADIO_BACKEND=dra uses those adapters.
# stub (default) is in-memory PTT/COS with no hardware.
# RADIO_BACKEND=stub
# RADIO_BACKEND=dra
# Bare systemd unit for Admin → Restart (Linux host; no .service suffix).
# SYSTEMD_UNIT=dvra-announcements
# DRA_USB_CHANNEL=left
# DRA_COS_LINE=vol_dn
# DRA_COS_ACTIVE_HIGH=false
# If the app never shows idle / clear countdown, run:
#   python scripts/dra36m_check.py monitor --cos vol_dn
# and toggle DRA_COS_ACTIVE_HIGH if idle/busy labels are swapped.
# Optional: comma-separated PortAudio match substrings or device indices (one per DRA).
# When unset, all C-Media / USB PnP Sound Device outputs are used (paired with HID paths).
# Two DRAs on one Linux host: leave DRA_HID_PATH unset; use fixed USB ports or set this if order is wrong.
# DRA_AUDIO_DEVICES=2,3
# Continuous COS idle required after synthesize, before PTT (bench voice-gate default: 10).
# DRA_CLEAR_SECONDS=10
# DRA_CLEAR_POLL_SECONDS=0.25
# DRA_FINAL_CHECK_SECONDS=1.0
# Background COS poll while the app runs (credits idle time before Trigger now). Default on.
# DRA_COS_TRACK=false
# Single DRA only (one radio on the Linux host): pin one CM119 HID (hex from probe).
# Do not set when two DRAs are connected — you need both CM119 HID interfaces.
# DRA_HID_PATH=
# Linux: unmute CM119 ALSA Speaker at startup (default on). Set false to skip.
# DRA_ALSA_UNMUTE=true
# DRA_ALSA_SPEAKER_LEVEL=100%
# DRA_ALSA_PLAYBACK_DEVICE=
# Prefer ALSA (hw:…) PortAudio names over PipeWire USB sinks (default on).
# DRA_PREFER_ALSA_HW=true
# Linux playback backend: aplay (default) or portaudio.
# DRA_LINUX_PLAYBACK=aplay

# Dev only: Trigger now on each schedule row. Plays the announcement without
# changing Last or the next scheduled slot.
# TRIGGER_NOW=false

# Verbose INFO logs for busy / defer / clear-hold / manual trigger retries (app.fire.trace).
# FIRE_VERBOSE_LOG=false

# Optional. If unset, a secret is created at data/.session_secret on first run.
# SESSION_SECRET=change-me-to-a-long-random-string

# Log out after this many idle seconds (default 1800 = 30 minutes).
# Session cookies also have no Max-Age, so they are dropped when the browser session ends.
# SESSION_IDLE_SECONDS=1800

# Failed sign-ins per username from the same client before HTTP 429.
# In-memory only; counters reset when the process restarts.
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=300
