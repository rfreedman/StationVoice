#!/usr/bin/env bash
# Deploy origin/main to the Linux host: stop the systemd unit, git pull, start the unit.
# Usage: scripts/deploy [host]
#   env: DEPLOY_HOST, DEPLOY_PATH, DEPLOY_BRANCH, SERVICE_NAME,
#        DEPLOY_STOP_TIMEOUT, DEPLOY_START_TIMEOUT
#
# Requires passwordless sudo on the host for systemctl/journalctl on this unit (sudo -n).
set -euo pipefail

HOST="${1:-${DEPLOY_HOST:-dvra-announcements}}"
REMOTE_PATH="${DEPLOY_PATH:-/home/announce/dvra-repeater-announcements}"
BRANCH="${DEPLOY_BRANCH:-main}"
SERVICE_NAME="${SERVICE_NAME:-dvra-announcements}"
stop_timeout="${DEPLOY_STOP_TIMEOUT:-30}"
start_timeout="${DEPLOY_START_TIMEOUT:-180}"
if [[ ! "$stop_timeout" =~ ^[1-9][0-9]*$ ]]; then
  echo "Invalid DEPLOY_STOP_TIMEOUT=$stop_timeout (positive integer seconds)." >&2
  exit 1
fi
if [[ ! "$start_timeout" =~ ^[1-9][0-9]*$ ]]; then
  echo "Invalid DEPLOY_START_TIMEOUT=$start_timeout (positive integer seconds)." >&2
  exit 1
fi

cd "$(dirname "$0")/.."

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Local working tree has uncommitted changes; commit and push first." >&2
  exit 1
fi
git fetch --quiet origin "$BRANCH"
if [[ -n "$(git rev-list "origin/$BRANCH..$BRANCH")" ]]; then
  echo "Local $BRANCH has commits not pushed to origin/$BRANCH; push first." >&2
  exit 1
fi

echo "Deploying origin/$BRANCH to $HOST:$REMOTE_PATH (${SERVICE_NAME}.service)"
ssh "$HOST" bash -s -- \
  "$REMOTE_PATH" "$BRANCH" "$SERVICE_NAME" "$stop_timeout" "$start_timeout" <<'REMOTE'
set -euo pipefail
cd "$1"
branch="$2"
SERVICE_NAME="$3"
stop_timeout="$4"
start_timeout="$5"
# Non-interactive ssh skips ~/.bashrc, where the uv installer adds itself; serve.sh needs uv to sync.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv not found on the Linux host (serve.sh needs it to sync dependencies); app left running." >&2
  exit 1
fi
if ! systemctl cat "${SERVICE_NAME}.service" &>/dev/null; then
  echo "Unit ${SERVICE_NAME}.service is not installed; app left running." >&2
  exit 1
fi

git fetch --quiet origin "$branch"
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "Linux host working tree has local changes; app left running." >&2
  git status --short --untracked-files=no >&2
  if [[ "$(git status --porcelain --untracked-files=no)" == " M uv.lock" ]]; then
    echo "If only uv.lock changed: git restore uv.lock on the Linux host, then redeploy (see docs/deploy.md)." >&2
  fi
  exit 1
fi
if ! git merge-base --is-ancestor HEAD "origin/$branch"; then
  echo "Linux host HEAD cannot fast-forward to origin/$branch; app left running." >&2
  exit 1
fi

version_at() {
  git show "$1:pyproject.toml" | sed -n 's/^version *= *"\(.*\)"/\1/p' | head -n 1
}
deployed="$(version_at HEAD)"
candidate="$(version_at "origin/$branch")"
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/$branch")" ]]; then
  newest="$(printf '%s\n%s\n' "$deployed" "$candidate" | sort -V | tail -n 1)"
  if [[ "$candidate" == "$deployed" || "$newest" != "$candidate" ]]; then
    echo "origin/$branch has new commits but version is $candidate (deployed: $deployed)." >&2
    echo "Bump it on the dev machine, then commit, push, and re-run scripts/deploy:" >&2
    echo "  uv version --bump patch     # or minor / major" >&2
    echo "App left running; nothing deployed." >&2
    exit 1
  fi
  echo "Deploying version $deployed -> $candidate"
fi

if systemctl is-active --quiet "${SERVICE_NAME}.service"; then
  echo "Stopping ${SERVICE_NAME}.service"
  if ! sudo -n systemctl stop "${SERVICE_NAME}.service"; then
    echo "sudo -n systemctl stop failed; app left running. See docs/deploy.md (NOPASSWD)." >&2
    exit 1
  fi
  for ((i = 0; i < stop_timeout; i++)); do
    systemctl is-active --quiet "${SERVICE_NAME}.service" || break
    sleep 1
  done
  if systemctl is-active --quiet "${SERVICE_NAME}.service"; then
    echo "App still active after ${stop_timeout}s." >&2
    echo "Not updating. Not sending SIGKILL (can leave PTT keyed)." >&2
    exit 1
  fi
else
  echo "App was not running"
fi

old="$(git rev-parse --short HEAD)"
git merge --quiet --ff-only "origin/$branch"
new="$(git rev-parse --short HEAD)"
echo "Updated $old -> $new (version $(version_at HEAD))"

since="$(date --iso-8601=seconds)"
echo "Starting ${SERVICE_NAME}.service"
if ! sudo -n systemctl start "${SERVICE_NAME}.service"; then
  echo "sudo -n systemctl start failed after git update. Start it manually on the host." >&2
  exit 1
fi

for ((i = 0; i < start_timeout; i++)); do
  if line="$(sudo -n journalctl -u "${SERVICE_NAME}.service" --since "$since" -o cat --no-pager \
    | grep -m 1 'Startup complete' || true)" \
    && [[ -n "$line" ]]; then
    echo "$line"
    if [[ "$line" == *"radio mode: stub"* ]]; then
      echo "WARNING: radio mode is stub; set TTS_RADIO_BACKEND=dra in .env for on-air playback." >&2
    fi
    exit 0
  fi
  if ! systemctl is-active --quiet "${SERVICE_NAME}.service"; then
    echo "Service is not active after start. Recent logs:" >&2
    sudo -n journalctl -u "${SERVICE_NAME}.service" -n 40 --no-pager >&2 || true
    exit 1
  fi
  sleep 1
done

echo "No 'Startup complete' after ${start_timeout}s. Recent logs:" >&2
sudo -n journalctl -u "${SERVICE_NAME}.service" -n 40 --no-pager >&2 || true
exit 1
REMOTE
