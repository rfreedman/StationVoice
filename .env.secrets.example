# Copy to .env.secrets and fill in real values.
# Never commit .env.secrets; do not include it in backups.
# Shared by station-local ops (scripts-local/backup-to-r2.py, Bird email plugin, cron).

# --- Cloudflare R2 (scripts-local/backup-to-r2.py; install: uv pip install boto3 botocore) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=repeater-announcements-backup
# Keep this many newest backups locally and in R2 (default 14).
R2_BACKUP_KEEP=14

# --- Bird email (after copying plugin-examples/bird_email.py into plugins/;
#     install SDK: uv pip install 'messagebird-sdk>=0.137.0') ---
BIRD_API_KEY=
EMAIL_FROM=repeater@yourdomain.com
EMAIL_FROM_NAME="StationVoice Repeater Announcements"
ADMIN_EMAILS="recipient1@yourdomain.com, recipient2@anotherdomain.com"
